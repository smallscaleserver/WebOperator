# Copy to .env and adjust before running `docker compose up`.

# Password required to connect to the noVNC session (Manual Takeover screen).
VNC_PASSWORD=changeme

# MinIO (S3-compatible artifact storage) root credentials.
MINIO_ROOT_USER=weboperator
MINIO_ROOT_PASSWORD=changeme123

# Gmail API OAuth credentials (Phase 3) -- from Google Cloud Console:
# console.cloud.google.com > APIs & Services > Credentials > OAuth client ID.
# Leave blank until you have real values -- gmail scripts fail with a
# clear error if these are missing, they never silently proceed.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4567/oauth2callback

# Telegram notifications for XC Bank Monitor (new transaction found,
# auto-stop fired) -- notification-only, never used to receive input
# or relay credentials anywhere. Leave blank to disable; the feature
# is fully optional (see services/control-panel/src/telegram.ts).
# Get a token from @BotFather, get your chat id by messaging your bot
# then checking https://api.telegram.org/bot<TOKEN>/getUpdates.
TELEGRAM_BOT_TOKEN_XC=
TELEGRAM_CHAT_ID_XC=
# Optional group chat, in addition to the private chat above -- both
# are notified independently if both are set. Add the bot to the
# group first, send /start in the group, then find the id from
# https://api.telegram.org/bot<TOKEN>/getUpdates (negative number,
# supergroups start with "-100").
TELEGRAM_GROUP_CHAT_ID=
