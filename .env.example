# Copy to .env and adjust before running `docker compose up`.

# Password required to connect to the noVNC session (Manual Takeover screen).
VNC_PASSWORD=changeme

# MinIO (S3-compatible artifact storage) root credentials.
MINIO_ROOT_USER=weboperator
MINIO_ROOT_PASSWORD=changeme123

# Gmail API OAuth credentials (Phase 3) -- from Google Cloud Console:
# console.cloud.google.com > APIs & Services > Credentials > OAuth client ID.
# Leave blank until you have real values -- gmail scripts fail with a
# clear error if these are missing, they never silently proceed.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4567/oauth2callback
